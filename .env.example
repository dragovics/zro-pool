# =============================================================================
# zro-pool — contoh environment
# Salin jadi `.env` lalu sesuaikan:   cp .env.example .env
# Semua variabel opsional — server punya default yang sama seperti di bawah.
# =============================================================================

# Port HTTP yang didengarkan gateway (dashboard /admin, API /v1, /healthz).
PORT=3600

# Username untuk login dashboard /admin.
ADMIN_USER=admin

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# !!!!!  PENTING: password default "admin" HANYA untuk setup pertama.   !!!!!
# !!!!!  GANTI SEGERA: set nilai kuat di sini, atau ganti dari          !!!!!
# !!!!!  dashboard setelah login pertama.                               !!!!!
# Catatan: nilai ini hanya dipakai saat seed awal — kalau password sudah
# tersimpan di database, perubahan di sini TIDAK menimpa yang lama.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
ADMIN_PASSWORD=admin

# Origin upstream Zro — TANPA `/v1` di akhir.
ZRO_BASE_URL=https://zro.moonmath.ai

# Lokasi file database SQLite.
# - Lokal / systemd : relatif ke working directory (nilai di bawah sudah oke).
# - Docker/compose  : otomatis dioverride ke /data/zro-pool.db (named volume),
#                     jadi nilai di bawah TIDAK dipakai di dalam container.
DB_PATH=./data/zro-pool.db

# Set kalau di belakang Caddy/Nginx (reverse proxy), supaya IP client asli
# terbaca benar (dipakai untuk rate-limit login & log).
# Kosongkan / hapus kalau port di-expose langsung tanpa proxy.
TRUST_PROXY=1

# Log level pino: trace | debug | info | warn | error
LOG_LEVEL=info
